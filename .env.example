NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=chai-cut-videos
SARVAM_API_KEY=your-sarvam-api-key

# ─── Payments (Razorpay) and credits ──────────────────────────────────────────
# These DUMMY keys run the whole payment flow on this site with no Razorpay account: a fake Razorpay
# answers inside the site (api/dev/razorpay) and a fake payment window opens. Nothing is charged.
RAZORPAY_KEY_ID=rzp_test_dummykey000001
RAZORPAY_KEY_SECRET=dummy_key_secret_change_me
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret_change_me
RAZORPAY_MOCK=1
# The address of this site, so the fake Razorpay can reach its webhook (api/billing/webhook)
APP_URL=http://localhost:3000
#
# Razorpay's real TEST mode (test cards, test UPI): paste your rzp_test_… keys above and delete RAZORPAY_MOCK.
# Real money: use rzp_live_… keys, delete RAZORPAY_MOCK (it is ignored in production anyway), and in the
# Razorpay dashboard add a webhook to https://<site>/api/billing/webhook with the same RAZORPAY_WEBHOOK_SECRET and the events
# subscription.activated, subscription.charged, subscription.cancelled, subscription.completed, subscription.halted, order.paid.
# Turn on auto-capture for payments. Nothing else changes: the code is the same for dummy, test and live keys.
#
# Invoices (GST): without COMPANY_GSTIN the paper says "Payment receipt", not "Tax invoice"
# COMPANY_GSTIN=
# COMPANY_STATE_CODE=36
# GST_RATE=18
#
# Credits: off (default, the site as before) | shadow (record spends, never refuse) | on
CREDITS_MODE=off
# Free credits given once to each account (0 = none)
# CREDITS_FREE_SIGNUP=30
